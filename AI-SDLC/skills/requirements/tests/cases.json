{
  "skill": "requirements",
  "skillVersion": "1.0.0",
  "description": "Golden cases for .claude/skills/requirements. `deterministic` cases run from AI-SDLC/ without a model; `live` cases need a headless Claude Code session.",
  "howToRun": [
    "cd AI-SDLC",
    "Run each deterministic case's input in a shell and compare with expect.",
    "Live cases: claude -p \"<case.input>\" --output-format json | jq -r '.result'"
  ],
  "cases": [
    {
      "id": "rq-01-reference-valid",
      "kind": "deterministic",
      "input": "node .claude/hooks/check-handoff.mjs workflows/examples/feature-patient-pagination/01-requirements.md; echo exit=$?",
      "expect": "PASS, exit=0"
    },
    {
      "id": "rq-02-acceptance-criteria",
      "kind": "deterministic",
      "input": "grep -c '^| AC-' workflows/examples/feature-patient-pagination/01-requirements.md",
      "expect": "6"
    },
    {
      "id": "rq-03-error-and-401-paths",
      "kind": "deterministic",
      "input": "grep -E '^\\| AC-(4|6) ' workflows/examples/feature-patient-pagination/01-requirements.md",
      "expect": "AC-4: 400 `OperationOutcome` with `issue[0].code` `invalid`; AC-6: 401 `OperationOutcome` for unauthenticated calls."
    },
    {
      "id": "rq-04-read-only",
      "kind": "deterministic",
      "input": "grep -E '^(allowed-tools|disallowed-tools):' .claude/skills/requirements/SKILL.md",
      "expect": "allowed-tools: Read Grep Glob\ndisallowed-tools: Edit Bash"
    }
  ]
}
