+package org.example.fhir.repository;
+
+import jakarta.persistence.EntityManager;
+import java.util.List;
+import org.example.fhir.domain.Patient;
+import org.springframework.stereotype.Repository;
+
+/** Partial family-name search for the front-desk lookup screen. */
+@Repository
+public class PatientNameSearch {
+
+    private final EntityManager em;
+
+    public PatientNameSearch(EntityManager em) {
+        this.em = em;
+    }
+
+    public List<Patient> byFamilyFragment(String fragment) {
+        String jpql = "select p from Patient p where lower(p.familyName) like '%"
+                + fragment.toLowerCase() + "%' order by p.id";
+        return em.createQuery(jpql, Patient.class).getResultList();
+    }
+}
