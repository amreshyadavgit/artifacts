 package org.example.fhir.repository;
 
+import java.util.Collection;
 import java.util.List;
 import org.example.fhir.domain.Observation;
 import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
 
 public interface ObservationRepository extends JpaRepository<Observation, Long> {
 
     List<Observation> findByPatientIdOrderByEffectiveDateTimeDesc(Long patientId);
 
     List<Observation> findByPatientIdAndCodeOrderByEffectiveDateTimeDesc(Long patientId, String code);
+
+    /** $lastn in one statement: the most recent Observation per patient (same ordering as the per-patient finders). */
+    @Query(nativeQuery = true, value = """
+            SELECT id, status, code_system, code, code_display, patient_id, effective_date_time, value_quantity, value_unit
+            FROM (SELECT o.*, ROW_NUMBER() OVER (PARTITION BY o.patient_id
+                                                 ORDER BY o.effective_date_time DESC, o.id DESC) AS rn
+                  FROM observation o
+                  WHERE o.patient_id IN (:patientIds)) ranked
+            WHERE rn = 1""")
+    List<Observation> findLatestPerPatient(@Param("patientIds") Collection<Long> patientIds);
+
+    /** As {@link #findLatestPerPatient} but restricted to one code (served by ix_observation_patient_code). */
+    @Query(nativeQuery = true, value = """
+            SELECT id, status, code_system, code, code_display, patient_id, effective_date_time, value_quantity, value_unit
+            FROM (SELECT o.*, ROW_NUMBER() OVER (PARTITION BY o.patient_id
+                                                 ORDER BY o.effective_date_time DESC, o.id DESC) AS rn
+                  FROM observation o
+                  WHERE o.patient_id IN (:patientIds) AND o.code = :code) ranked
+            WHERE rn = 1""")
+    List<Observation> findLatestPerPatientByCode(@Param("patientIds") Collection<Long> patientIds,
+                                                 @Param("code") String code);
 }
