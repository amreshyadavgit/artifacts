{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.phi.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push --force *)",
      "Bash(gh pr merge *)",
      "mcp__github__merge_pull_request"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(kubectl apply *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "node /etc/claude-code/hooks/guard-outbound.mjs", "timeout": 10 }
        ]
      }
    ]
  }
}
