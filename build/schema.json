{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc-module.schema.json",
  "title": "AI-SDLC curriculum module",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "level", "title", "summary", "prerequisites", "concepts", "diagrams", "comparisonTables", "exercises", "agentContracts", "checklist"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
    "level": { "type": "integer", "minimum": 1, "maximum": 9 },
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 40 },
    "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "concepts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["heading", "body_md"],
        "properties": {
          "heading": { "type": "string", "minLength": 2 },
          "body_md": { "type": "string", "minLength": 40 }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "mermaid"],
        "properties": {
          "title": { "type": "string", "minLength": 2 },
          "mermaid": { "type": "string", "minLength": 10 }
        }
      }
    },
    "comparisonTables": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "columns", "rows"],
        "properties": {
          "title": { "type": "string" },
          "columns": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "rows": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "string" } } }
        }
      }
    },
    "exercises": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "objective", "startingFiles", "requiredStructure", "implementation", "exampleInput", "expectedOutput", "testCases", "evaluationCriteria", "improvements"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 3 },
          "objective": { "type": "string", "minLength": 20 },
          "startingFiles": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "content"],
              "properties": { "path": { "type": "string", "minLength": 1 }, "content": { "type": "string" } }
            }
          },
          "requiredStructure": { "type": "string", "minLength": 5 },
          "implementation": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "language", "content", "tag"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "language": { "type": "string", "minLength": 1 },
                "content": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "enum": ["verified-format", "illustrative"] }
              }
            }
          },
          "exampleInput": { "type": "string", "minLength": 1 },
          "expectedOutput": { "type": "string", "minLength": 1 },
          "testCases": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "input", "expected"],
              "properties": { "name": { "type": "string" }, "input": { "type": "string" }, "expected": { "type": "string" } }
            }
          },
          "evaluationCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "improvements": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "agentContracts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["agent", "purpose", "inputs", "outputs", "tools", "permissions", "must", "mustNot", "failureConditions", "validation", "handoffFormat", "humanGate"],
        "properties": {
          "agent": { "type": "string", "enum": ["architect", "developer", "reviewer", "tester", "security", "sre", "orchestrator"] },
          "purpose": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "permissions": { "type": "string" },
          "must": { "type": "array", "items": { "type": "string" } },
          "mustNot": { "type": "array", "items": { "type": "string" } },
          "failureConditions": { "type": "array", "items": { "type": "string" } },
          "validation": { "type": "string" },
          "handoffFormat": { "type": "string" },
          "humanGate": { "type": "string" }
        }
      }
    },
    "checklist": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
