+@frappe.whitelist(methods=["GET"])
+def observations_for_patient(patient: str):
+	"""All Observations of one patient, newest first (encounter screen)."""
+	rows = frappe.get_all(
+		"SL Observation",
+		filters={"patient": parse_reference(patient)},
+		fields=["name", "patient", "code", "code_display", "status", "effective_datetime", "value", "unit"],
+		order_by="effective_datetime desc",
+	)
+	log_access("read", "SL Observation", [r.name for r in rows], result_count=len(rows))
+	return bundle([observation_to_fhir(r) for r in rows])
