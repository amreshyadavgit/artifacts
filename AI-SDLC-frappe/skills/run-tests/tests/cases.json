{
  "skill": "run-tests",
  "skillVersion": "1.0.0",
  "format": "skill-golden-cases/v1",
  "runFrom": "AI-SDLC-frappe/",
  "howToRun": {
    "live": "Run claude -p \"<input.invoke>\" --output-format json from AI-SDLC-frappe/ (after input.setup, if any) and compare .result and the files it wrote with expect.",
    "deterministic": "Run input.command with bash from AI-SDLC-frappe/ and compare the exit code and combined stdout+stderr with expect (exitCode, stdoutContains, stdoutNotContains)."
  },
  "cases": [
    {
      "id": "rt-01-parser-unit-tests",
      "kind": "deterministic",
      "title": "The parser's 12 unit tests pass without a bench",
      "input": {
        "command": "python3 -m unittest discover -s .claude/skills/run-tests/scripts -p 'test_*.py' 2>&1 | tail -3"
      },
      "expect": {
        "exitCode": 0,
        "stdoutContains": [
          "Ran 12 tests",
          "OK"
        ]
      }
    },
    {
      "id": "rt-02-green-run",
      "kind": "deterministic",
      "title": "A green whole-app capture is PASS with 46 tests and the D-2 query error counted, not shown",
      "input": {
        "command": "python3 .claude/skills/run-tests/scripts/parse_bench_tests.py .claude/skills/run-tests/scripts/fixtures/green-app.txt; echo \"exit=$?\""
      },
      "expect": {
        "exitCode": 0,
        "stdoutContains": [
          "## Test summary: PASS",
          "46 tests: 46 passed, 0 failed, 0 errors, 0 skipped",
          "Not shown: 1 'Error in query' line(s)",
          "exit=0"
        ]
      }
    },
    {
      "id": "rt-03-regression-is-fail",
      "kind": "deterministic",
      "title": "The regression capture (bench exited 0) is FAIL and names the failing test and its line",
      "input": {
        "command": "python3 .claude/skills/run-tests/scripts/parse_bench_tests.py .claude/skills/run-tests/scripts/fixtures/regression-app.txt; echo \"exit=$?\""
      },
      "expect": {
        "exitCode": 0,
        "stdoutContains": [
          "## Test summary: FAIL",
          "45 passed, 1 failed",
          "FAIL test_final_requires_value_and_unit",
          "test_sl_observation.py:25",
          "exit=1"
        ]
      }
    },
    {
      "id": "rt-04-zero-tests-is-not-pass",
      "kind": "deterministic",
      "title": "A --test that matches nothing is NO TESTS with exit 2, although bench printed OK",
      "input": {
        "command": "python3 .claude/skills/run-tests/scripts/parse_bench_tests.py .claude/skills/run-tests/scripts/fixtures/unknown-test.txt; echo \"exit=$?\""
      },
      "expect": {
        "exitCode": 0,
        "stdoutContains": [
          "## Test summary: NO TESTS",
          "Ran 0 tests",
          "exit=2"
        ]
      }
    },
    {
      "id": "rt-05-crash",
      "kind": "deterministic",
      "title": "An unknown --module is CRASHED with the ModuleNotFoundError",
      "input": {
        "command": "python3 .claude/skills/run-tests/scripts/parse_bench_tests.py .claude/skills/run-tests/scripts/fixtures/unknown-module.txt; echo \"exit=$?\""
      },
      "expect": {
        "exitCode": 0,
        "stdoutContains": [
          "## Test summary: CRASHED",
          "ModuleNotFoundError: No module named 'spice_lite.tests.test_nope'",
          "exit=2"
        ]
      }
    },
    {
      "id": "rt-06-no-msgprint-text",
      "kind": "deterministic",
      "title": "The verbose capture's Message: lines and tb_locals never reach the summary",
      "input": {
        "command": "grep -cE '^\\s*Message:|self = <' .claude/skills/run-tests/scripts/fixtures/regression-verbose-module.txt; python3 .claude/skills/run-tests/scripts/parse_bench_tests.py .claude/skills/run-tests/scripts/fixtures/regression-verbose-module.txt | grep -cE '^\\s*Message:|self = <'"
      },
      "expect": {
        "exitCode": 1,
        "stdoutContains": [
          "14\n0\n"
        ]
      }
    },
    {
      "id": "rt-07-unsafe-argument",
      "kind": "live",
      "title": "An argument with a shell separator is rejected and no bench command runs",
      "input": {
        "invoke": "/run-tests spice_lite.tests.test_fhir_api;bench --site test.localhost console"
      },
      "expect": {
        "resultContains": [
          "rejected"
        ],
        "permissionDenialsOrBashCalls": 0
      }
    },
    {
      "id": "rt-08-live-green",
      "kind": "live",
      "title": "On the unmodified app the skill reports READY with 46 tests",
      "input": {
        "invoke": "/run-tests"
      },
      "expect": {
        "resultContains": [
          "## Test summary: PASS",
          "46 tests",
          "READY"
        ]
      }
    }
  ]
}
