@@ -0,0 +1,21 @@
+# Copyright (c) 2026, AI-SDLC Course and contributors
+# License: MIT. See license.txt
+"""v0.2: SL Observation.code became a Link to SL Observation Code.
+
+Rows saved before that change may use codes that are not in the vocabulary; they would fail
+link validation on their next save (for example when a clinician amends them). Create a
+vocabulary entry for every distinct code in use. Runs in [post_model_sync] because it needs
+the new DocType; the shipped fixtures are imported after it and overwrite shipped codes.
+"""
+
+import frappe
+
+
+def execute():
+	# get_all / ignore_permissions: a patch runs as Administrator during migrate, not in a request.
+	codes = frappe.get_all("SL Observation", pluck="code", distinct=True)
+	for code in codes:
+		display = frappe.db.get_value("SL Observation", {"code": code}, "code_display") or code
+		frappe.get_doc({"doctype": "SL Observation Code", "code": code, "display": display}).insert(
+			ignore_permissions=True
+		)
