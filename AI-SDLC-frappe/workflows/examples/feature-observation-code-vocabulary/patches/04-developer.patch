@@ -0,0 +1,63 @@
+# Copyright (c) 2026, AI-SDLC Course and contributors
+# See license.txt
+
+import frappe
+from frappe.tests.utils import FrappeTestCase
+
+from spice_lite.patches.v0_2 import backfill_observation_codes
+from spice_lite.tests.utils import ensure_test_users, make_observation, make_patient
+
+SHIPPED = {"8480-6", "8462-4", "8867-4", "2339-0", "29463-7", "8302-2"}
+
+
+class TestSLObservationCode(FrappeTestCase):
+	@classmethod
+	def setUpClass(cls):
+		super().setUpClass()
+		ensure_test_users()
+
+	def setUp(self):
+		self.patient = make_patient()
+
+	def tearDown(self):
+		frappe.set_user("Administrator")
+
+	def test_shipped_codes_are_installed_from_fixtures(self):
+		installed = set(frappe.get_all("SL Observation Code", pluck="name"))
+		self.assertTrue(SHIPPED <= installed, SHIPPED - installed)
+
+	def test_unknown_code_rejected(self):
+		self.assertRaises(frappe.LinkValidationError, make_observation, self.patient.name, code="0000-0")
+
+	def test_display_fetched_when_empty(self):
+		obs = make_observation(self.patient.name, code="8480-6", code_display=None)
+		self.assertEqual(obs.code_display, "Systolic blood pressure")
+
+	def test_final_unit_must_match_code_unit(self):
+		self.assertRaises(frappe.ValidationError, make_observation, self.patient.name, code="8480-6", unit="kPa")
+
+	def test_disabled_code_rejected_for_new_observations(self):
+		frappe.get_doc({"doctype": "SL Observation Code", "code": "99990-1", "display": "Retired test code", "disabled": 1}).insert()
+		self.assertRaises(frappe.ValidationError, make_observation, self.patient.name, code="99990-1", unit="x")
+
+
+class TestBackfillObservationCodes(FrappeTestCase):
+	@classmethod
+	def setUpClass(cls):
+		super().setUpClass()
+		ensure_test_users()
+
+	def test_backfill_creates_codes_for_legacy_rows(self):
+		# a row saved before `code` became a Link: insert it without validation
+		legacy = frappe.get_doc(
+			{
+				"doctype": "SL Observation",
+				"patient": make_patient().name,
+				"code": "99991-2",
+				"code_display": "Legacy local code",
+				"status": "preliminary",
+			}
+		)
+		legacy.db_insert()
+		backfill_observation_codes.execute()
+		self.assertEqual(frappe.db.get_value("SL Observation Code", "99991-2", "display"), "Legacy local code")
