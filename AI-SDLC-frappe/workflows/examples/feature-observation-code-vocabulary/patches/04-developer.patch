+# Copyright (c) 2026, AI-SDLC Course and contributors
+# For license information, please see license.txt
+
+import frappe
+from frappe import _
+from frappe.model.document import Document
+
+
+class SLObservationCode(Document):
+	"""One entry of the deployment's Observation vocabulary (LOINC code, display, UCUM unit).
+
+	Shipped codes live in `spice_lite/fixtures/sl_observation_code.json` and are re-imported
+	(overwritten) on every `bench migrate`. Country-specific codes belong in the country app.
+	"""
+
+	def validate(self):
+		self.code = (self.code or "").strip()
+		if not self.code or any(c.isspace() for c in self.code):
+			frappe.throw(_("Code must be a single LOINC code without spaces"))
+		self.unit = (self.unit or "").strip() or None
