+@frappe.whitelist(allow_guest=True)
+def find_patients(name: str):
+	"""Front-desk lookup: patients whose last name contains `name`."""
+	rows = frappe.db.sql(
+		f"""select name, mrn, first_name, last_name, birth_date
+		from `tabSL Patient`
+		where last_name like '%{name}%'
+		order by last_name""",
+		as_dict=True,
+	)
+	if not rows:
+		frappe.log_error(title="find_patients: no match", message=f"No patient matched '{name}'")
+	return rows
